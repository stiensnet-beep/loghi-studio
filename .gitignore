# local settings, caches and logs. Also the lines checked by people: they can hold text of scans that may
# not be shared. For a copy of them in a private repository of your own, see the README (Structure).
settings/
instellingen/
cache/
__pycache__/
*.pyc
server.err
server.log
# never commit scans, models or transcriptions
*.jpg
*.jpeg
*.png
!docs/screenshots/*.png
*.pth
models/
# training sets made from the checked lines (can be made again; line images of scans)
training/
# trial runs of the test set (can be made again)
testset/runs/
# notes of a reviewer of the public copy
review/
# books put next to compose.yml for server mode
deploy/data/
